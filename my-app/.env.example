# Day23 配置模板：全部为虚构占位值，不包含真实密钥。
# 本地前端：复制到被忽略的 .env.local，只替换下方公开配置。
# VITE_ 变量会进入浏览器，绝不能填写密码、API Key 或 access_token。
VITE_API_ORIGIN=https://api.example.com
VITE_STATIC_ORIGIN=https://app.example.com
VITE_AUTH_ORIGIN=https://auth.example.com
VITE_TEST_USER_ID=fictional-test-user-id

# 云函数：在 CloudBase 服务端环境变量/既有密钥注入处配置，不上传 .env。
# 下列空值故意不可用；本项目不会自动把此文件加载为云函数配置。
ALLOWED_ORIGIN=https://app.example.com
CLOUDBASE_ENV_ID=example-env-id
CLOUDBASE_APIKEY=
# 至少 32 字节的随机服务端签名密钥，仅在云平台安全生成和保存。
CURSOR_SECRET=
